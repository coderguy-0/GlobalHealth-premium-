# ---- GlobalHealth runtime configuration -------------------------------
# Copy to .env and fill with your own values. Never commit real secrets.

# HTTP port (default 3000)
PORT=3000

# Public same-origin base for deep links / internal links.
APP_URL=http://localhost:3000

# AI generation provider (leave blank to run the platform without AI; urgent
# safety responses still work because they are server-side).
GEMINI_API_KEY=

# Explicit CORS allowlist (comma-separated origins). REQUIRED for production
# cross-origin browser clients; unknown origins are rejected when NODE_ENV=production.
CORS_ORIGIN=https://globalhealth.example

# Medical registry gateway for real credential verification (no local fixtures).
# The endpoint only returns VERIFIED when these are configured AND the gateway
# confirms the credential.
MEDAUTH_REGISTRY_URL=
MEDAUTH_REGISTRY_SECRET=

# Administrator key for pharmacy-partner verification actions. This used to
# fall back to a demo key; production now fails closed when it is unset.
GH_ADMIN_KEY=

# Prescription signing secret. When unset, prescriptions are prepared with an
# explicit UNSIGNED status instead of being signed with a predictable value.
PRESCRIPTION_SIGNING_SECRET=

# News Management bootstrap administrator (only used in production). If unset,
# the server does NOT load demo staff accounts and News Management fails closed.
NEWS_ADMIN_BOOTSTRAP_EMAIL=
NEWS_ADMIN_BOOTSTRAP_PASSWORD=
NEWS_ADMIN_BOOTSTRAP_NAME=GlobalHealth News Administrator

# Runtime persistence directory (default data/). Git-ignored, written with
# restrictive permissions on account/domain stores.
GH_RUNTIME_DIR=data

# Portal frontend URLs used for deep links / external navigation.
VITE_DOCTOR_PORTAL_URL=
VITE_HOSPITAL_PORTAL_URL=
VITE_PHARMACY_PORTAL_URL=
